<div class="container mt-4">
  <div class="-flex justify-content-between align-items-center">
    <h1>Todos os restaurantes</h1>
    <%= link_to "Novo Restaurante", new_restaurant_path, class:"btn-btn-primary" %>
  </div>

<ul class="list-group mt-3">
  <% @restaurants.each do |restaurant| %>
    <li class="list-group-item d-flex justify-content-between align-items-center">
      <div>
        <strong><%= restaurant.name %></strong> - <span class="text-murted"><%= restaurant.category %></span>
        <p class="mb-0 text-secondary"><%= restaurant.address %></p>>
      </div>
      <%= link_to "Ver Detalhes", restaurant_path(restaurant), class: "btn btn-sm btn-outline-secondary" %>
    </li>
  <% end %>
</ul></div>

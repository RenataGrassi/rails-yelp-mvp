<div class="container mt-4">
  <div class="card p-4 shadow-sm mb-4">
    <h1><%= @restaurant.name %></h1>
    <p class="text-muted">Categoria: <span class="badge bg-info text-dark"><%= @restaurant.category %></span></p>
    <p><strong>Endereço:</strong> <%= @restaurant.address %></p>
    <p><strong>Telefone:</strong> <%= @restaurant.phone_number %></p>

    <div class="mt-3">
      <%= link_to "Voltar para a Lista", restaurants_path, class: "btn btn-outline-secondary" %>
      <%= link_to "Escrever uma Avaliação (Review)", new_restaurant_review_path(@restaurant), class: "btn btn-primary" %>
    </div>
  </div>

  <ul class="list-group mt-3">
    <% if @restaurant.reviews.empty? %>
      <li class="list-group-item text-muted">Nenhuma avaliação ainda. Seja o primeiro!</li>
    <% else %>
      <% @restaurant.reviews.each do |review| %>
        <li class="list-group-item">
          <strong>Nota: <%= "⭐" * review.rating %> (<%= review.rating %>/5)</strong>
          <p class="mb-0 mt-1 text-secondary"><%= review.content %></p>
        </li>
      <% end %>
    <% end %>
  </ul>
</div>
